{
  "name": "blueprint-reboot-frontend",
  "version": "1.6.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "demo:build": "vite build --config demo.vite.config.ts",
    "demo:test": "node --test tests/bandal-demo.test.mjs",
    "test": "npm run build && node --test tests/*.test.mjs app/lib/workspace/*.test.mjs app/lib/exploration/*.test.mjs app/lib/review/*.test.mjs app/lib/ai/*.test.mjs ../hosting/tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "predemo:build": "node scripts/prepare-ocr-assets.mjs",
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "test:labvium": "node --test tests/bandal-demo.test.mjs tests/browser-workspace.test.mjs tests/reader-cited-evidence.test.mjs tests/workspace-scope-isolation.test.mjs tests/labvium-i18n.test.mjs tests/pdf-ocr.test.mjs app/lib/workspace/*.test.mjs app/lib/exploration/*.test.mjs app/lib/review/*.test.mjs app/lib/ai/*.test.mjs ../hosting/tests/*.test.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "lucide-react": "1.24.0",
    "next": "16.2.6",
    "pdfjs-dist": "5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
